@page "/weather"
@using WeatherAgent.Web.Services
@inject IWeatherAgentService WeatherService

<PageTitle>WeatherTaste - Weather Suggestions</PageTitle>

<div class="weather-container">
    <div class="weather-header">
        <h1>🌤️ WeatherTaste</h1>
        <p class="subtitle">Get personalized clothing and food suggestions based on weather</p>
    </div>

    <div class="search-section">
        <div class="input-group">
            <input type="text" 
                   class="form-control search-input" 
                   placeholder="Enter city name (e.g., São Paulo, New York, London)" 
                   @bind="location" 
                   @bind:event="oninput"
                   @onkeypress="HandleKeyPress"
                   disabled="@isLoading" />
            <button class="btn btn-primary search-btn" 
                    @onclick="GetSuggestion" 
                    disabled="@(isLoading || string.IsNullOrWhiteSpace(location))">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Loading...</span>
                }
                else
                {
                    <span>Get Suggestions</span>
                }
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-4" role="alert">
            <strong>Error:</strong> @errorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(agentResponse))
    {
        <div class="response-card mt-4">
            <div class="response-content">
                @((MarkupString)FormatResponse(agentResponse))
            </div>
        </div>
    }
</div>

@code {
    private string location = "";
    private string agentResponse = "";
    private string errorMessage = "";
    private bool isLoading = false;

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(location))
        {
            await GetSuggestion();
        }
    }

    private async Task GetSuggestion()
    {
        if (string.IsNullOrWhiteSpace(location))
        {
            errorMessage = "Please enter a city name";
            return;
        }

        isLoading = true;
        errorMessage = "";
        agentResponse = "";
        StateHasChanged();

        try
        {
            var result = await WeatherService.GetWeatherSuggestionAsync(location.Trim());

            if (result.IsSuccess)
            {
                agentResponse = result.AgentResponse ?? "No response received";
            }
            else
            {
                errorMessage = result.ErrorMessage ?? "An unknown error occurred";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Connection error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private string FormatResponse(string response)
    {
        if (string.IsNullOrEmpty(response))
            return "";

        // Convert markdown-style formatting to HTML
        var formatted = response
            .Replace("\n\n", "</p><p>")
            .Replace("\n", "<br/>")
            .Replace("**", "")
            .Replace("1)", "<strong>1)</strong>")
            .Replace("2)", "<strong>2)</strong>")
            .Replace("3)", "<strong>3)</strong>")
            .Replace("4)", "<strong>4)</strong>");

        return $"<p>{formatted}</p>";
    }
}
